// ==UserScript==
// @name         VLTK Idle - Auto Snake Pixel Bot v40.1
// @namespace    [http://tampermonkey.net/](http://tampermonkey.net/)
// @version      40.1
// @description  Sửa lỗi cú pháp Update - Quét pixel Canvas #arena tự ăn mồi & né tường
// @match        *://hoainiem2003.net/*
// @allFrames    true
// @grant        none
// @run-at       document-end
// ==/UserScript==

(function() {
    'use strict';

    const REMOTE_CODE_URL = '[https://raw.githubusercontent.com/hunterkay01/vltk-auto-tool/main/auto%20speed](https://raw.githubusercontent.com/hunterkay01/vltk-auto-tool/main/auto%20speed)';

    window.vltkSpeedEnabled = true;
    window.vltkSelectedSpeed = 1;
    window.vltkAutoCS = true;
    window.vltkAutoRemotePick = true;
    window.vltkAutoThap1 = false;
    window.vltkAutoThap2 = false;
    window.vltkDodgeSkill = false;
    window.vltkAutoSnake = true;

    let isCsProcessing = false;
    let dodgeAngle = 0;
    let isMinigameOpen = false;
    let lastDir = 'RIGHT';

    function triggerFullClick(el) {
        if (!el) return false;
        const events = ['pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click'];
        events.forEach(evt => {
            try {
                const e = new MouseEvent(evt, { view: window, bubbles: true, cancelable: true });
                el.dispatchEvent(e);
            } catch(err) {}
        });
        if (typeof el.click === 'function') el.click();
        return true;
    }

    function clickByText(text) {
        const allNodes = document.querySelectorAll('button, div, span, a, p, td');
        for (let el of allNodes) {
            if (el.innerText && el.innerText.trim() === text) {
                triggerFullClick(el);
                return true;
            }
        }
        return false;
    }

    // 🐍 THUẬT TOÁN QUÉT PIXEL CANVAS #ARENA ĐỂ TÌM MỒI VÀ NÉ TƯỜNG
    function processCanvasPixelSnake() {
        if (!window.vltkAutoSnake) return;

        const cv = document.getElementById('arena');
        if (!cv || cv.offsetWidth === 0) return;

        try {
            const ctx = cv.getContext('2d');
            const rect = cv.getBoundingClientRect();

            // 1. Click tự động chơi lại khi kết thúc
            const clickX = rect.left + rect.width * 0.38;
            const clickY = rect.top + rect.height * 0.63;
            const mEvt = new MouseEvent('click', { clientX: clickX, clientY: clickY, bubbles: true });
            cv.dispatchEvent(mEvt);

            if (!ctx) return;

            // 2. Phân tích ma trận màu trên Canvas (15x15)
            const cols = 15;
            const rows = 15;
            const cellW = cv.width / cols;
            const cellH = cv.height / rows;

            let head = null;
            let food = null;

            for (let r = 0; r < rows; r++) {
                for (let c = 0; c < cols; c++) {
                    const cx = Math.floor(c * cellW + cellW / 2);
                    const cy = Math.floor(r * cellH + cellH / 2);
                    const pixel = ctx.getImageData(cx, cy, 1, 1).data;
                    const red = pixel[0], green = pixel[1], blue = pixel[2];

                    // Nhận diện mồi tròn màu vàng/cam
                    if (red > 180 && green > 100 && blue < 120) {
                        food = { x: c, y: r };
                    }
                    // Nhận diện đầu rắn màu xanh lá tươi
                    else if (green > 160 && red < 120 && blue < 120) {
                        head = { x: c, y: r };
                    }
                }
            }

            // 3. Tính toán hướng đi an toàn nhất
            let targetDir = lastDir;

            if (head && food) {
                if (head.x < food.x && lastDir !== 'LEFT') targetDir = 'RIGHT';
                else if (head.x > food.x && lastDir !== 'RIGHT') targetDir = 'LEFT';
                else if (head.y < food.y && lastDir !== 'UP') targetDir = 'DOWN';
                else if (head.y > food.y && lastDir !== 'DOWN') targetDir = 'UP';
            }

            // Khóa né đâm tường khẩn cấp
            if (head) {
                if (targetDir === 'RIGHT' && head.x >= cols - 1) targetDir = (head.y < rows - 1) ? 'DOWN' : 'UP';
                if (targetDir === 'LEFT' && head.x <= 0) targetDir = (head.y < rows - 1) ? 'DOWN' : 'UP';
                if (targetDir === 'DOWN' && head.y >= rows - 1) targetDir = (head.x < cols - 1) ? 'RIGHT' : 'LEFT';
                if (targetDir === 'UP' && head.y <= 0) targetDir = (head.x < cols - 1) ? 'RIGHT' : 'LEFT';
            }

            // 4. Bấm phím di chuyển
            const keyMap = {
                'RIGHT': { key: 'ArrowRight', code: 39 },
                'DOWN': { key: 'ArrowDown', code: 40 },
                'LEFT': { key: 'ArrowLeft', code: 37 },
                'UP': { key: 'ArrowUp', code: 38 }
            };

            const k = keyMap[targetDir];
            if (k) {
                lastDir = targetDir;
                const kEvt = new KeyboardEvent('keydown', {
                    key: k.key, code: k.key, keyCode: k.code, which: k.code, bubbles: true, cancelable: true
                });
                cv.dispatchEvent(kEvt);
                window.dispatchEvent(kEvt);
            }
        } catch(e) {}
    }

    // 🔄 CẬP NHẬT CODE AN TOÀN (BẢO VỆ CHỐNG LỖI CÚ PHÁP)
    function performAutoUpdate(btnUpdate) {
        btnUpdate.innerText = '⏳ Đang tải...';
        btnUpdate.style.background = '#fab387';

        fetch(REMOTE_CODE_URL + '?t=' + new Date().getTime())
            .then(res => res.text())
            .then(code => {
                // Loại bỏ mã định dạng Markdown nếu lỡ dán trên GitHub
                let cleanCode = code.replace(/```javascript/g, '').replace(/```/g, '').trim();
                
                try {
                    new Function(cleanCode); // Kiểm tra cú pháp trước khi lưu
                    localStorage.setItem('VLTK_CUSTOM_SCRIPT', cleanCode);
                    btnUpdate.innerText = '✅ Thành công!';
                    btnUpdate.style.background = '#a6e3a1';
                    alert('Cập nhật bản mới thành công! Trang web sẽ tự động tải lại.');
                    location.reload();
                } catch(err) {
                    alert('Lỗi: File tải về từ GitHub có chứa lỗi cú pháp JavaScript!');
                    btnUpdate.innerText = '🔄 Cập nhật Tool';
                    btnUpdate.style.background = '#89b4fa';
                }
            })
            .catch(() => {
                alert('Không thể kết nối lấy bản cập nhật!');
                btnUpdate.innerText = '🔄 Cập nhật Tool';
                btnUpdate.style.background = '#89b4fa';
            });
    }

    // KIỂM TRA MINI-GAME
    function checkMinigameStatus() {
        try {
            const cv = document.getElementById('arena');
            isMinigameOpen = !!(cv && cv.offsetWidth > 0);
            if (isMinigameOpen) {
                processCanvasPixelSnake();
            }
        } catch(e) {
            isMinigameOpen = false;
        }
    }

    // SPEED CONTROL & RAF ENGINE
    const originalRAF = window.requestAnimationFrame;
    let lastTime = performance.now();
    let virtualTime = lastTime;

    window.requestAnimationFrame = function(callback) {
        return originalRAF(function(now) {
            const dt = now - lastTime;
            lastTime = now;
            const currentSpeed = (window.vltkSpeedEnabled && !isMinigameOpen) ? (window.vltkSelectedSpeed || 1) : 1;
            virtualTime += dt * currentSpeed;
            callback(virtualTime);
        });
    };

    setInterval(checkMinigameStatus, 150);

    // DOCK UI
    function injectUI() {
        if (document.getElementById('vltk-dock-container')) return;
        const targetBody = document.body || document.documentElement;
        if (!targetBody) return;

        const container = document.createElement('div');
        container.id = 'vltk-dock-container';
        container.innerHTML = `
            <div id="v-dock-bar" style="position: fixed; top: 120px; left: 10px; z-index: 2147483647; display: flex; flex-direction: column; gap: 8px; background: rgba(24, 24, 37, 0.95); border: 2px solid #f9e2af; border-radius: 12px; padding: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.8); user-select: none;">
                <div id="v-dock-drag" style="cursor: move; text-align: center; color: #f9e2af; font-size: 10px; font-weight: bold; padding-bottom: 2px; border-bottom: 1px dashed #45475a;">🖐️</div>
                <button id="v-icon-speed" style="background:#313244; color:#f9e2af; border:1px solid #45475a; border-radius:8px; width:42px; height:42px; font-size:20px; cursor:pointer;" title="Hack Speed">⚡</button>
                <button id="v-icon-mini" style="background:#313244; color:#f9e2af; border:1px solid #45475a; border-radius:8px; width:42px; height:42px; font-size:20px; cursor:pointer;" title="Auto Mini Game">🎮</button>
            </div>
            <div id="v-popup-panel" style="position: fixed; top: 120px; left: 75px; z-index: 2147483647; background: #181825; border: 2px solid #f9e2af; border-radius: 10px; padding: 12px; color: #cdd6f4; font-family: Tahoma, Arial, sans-serif; font-size: 12px; width: 240px; display: none; user-select: none;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; background: #232334; padding: 4px 8px; border-radius: 5px;">
                    <span id="v-popup-title" style="font-weight: bold; color: #f9e2af;">🎮 MINI GAME BOT</span>
                    <button id="v-popup-close" style="background:#f38ba8; color:#11111b; border:none; border-radius:4px; width:20px; height:20px; cursor:pointer;">✖</button>
                </div>
                <button id="v-btn-update-code" style="width: 100%; background: #89b4fa; color: #11111b; border: none; border-radius: 4px; padding: 6px 0; font-weight: bold; cursor: pointer; margin-top: 6px;">🔄 Cập nhật Tool Mới</button>
            </div>
        `;
        targetBody.appendChild(container);

        const popup = container.querySelector('#v-popup-panel');
        const popupClose = container.querySelector('#v-popup-close');
        const btnMini = container.querySelector('#v-icon-mini');
        const btnUpdateCode = container.querySelector('#v-btn-update-code');

        btnMini.onclick = () => { popup.style.display = (popup.style.display === 'none') ? 'block' : 'none'; };
        popupClose.onclick = () => { popup.style.display = 'none'; };
        btnUpdateCode.onclick = () => performAutoUpdate(btnUpdateCode);
    }

    injectUI();
    setInterval(injectUI, 2000);
})();
