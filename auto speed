// @description  Tự động quét Pixel Canvas #arena, định vị chấm vàng & chạy thuật toán BFS ăn mồi không đâm đuôi/tường
// @match        *://hoainiem2003.net/*
// @allFrames    true
// @grant        none
// @run-at       document-end
