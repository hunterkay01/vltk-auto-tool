(function() {
    'use strict';

    const REMOTE_CODE_URL = 'https://raw.githubusercontent.com/hunterkay01/vltk-auto-tool/main/auto%20speed';

    window.vltkSpeedEnabled = true;
    window.vltkSelectedSpeed = 1;
    window.vltkSpeed = 1;
    
    window.vltkAutoCS = true;
    window.vltkAutoRemotePick = true;

    window.vltkAutoThap1 = false;
    window.vltkAutoThap2 = false;
    window.vltkDodgeSkill = false;
    window.vltkAutoSnake = true; // Auto Rắn săn mồi qua Vision Engine

    let isCsProcessing = false;
    let dodgeAngle = 0;
    let isMinigameOpen = false;
    let autoEventInterval = null;

    function triggerFullClick(el) {
        if (!el) return false;
        const events = ['pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click'];
        events.forEach(evt => {
            try {
                const e = new MouseEvent(evt, {
                    view: window,
                    bubbles: true,
                    cancelable: true
                });
                el.dispatchEvent(e);
            } catch(err) {}
        });
        if (typeof el.click === 'function') {
            try { el.click(); } catch(err) {}
        }
        return true;
    }

    function clickByText(text, exact = false) {
        const allNodes = document.querySelectorAll('button, div, span, a, p, td');
        let found = false;
        for (let el of allNodes) {
            if (el.innerText) {
                const inner = el.innerText.trim();
                if (exact ? inner === text : inner.includes(text)) {
                    triggerFullClick(el);
                    found = true;
                }
            }
        }
        return found;
    }

    // =========================================================================
    // 🐍 ENGINE THỊ GIÁC CANVAS & THUẬT TOÁN BFS DỰA TRÊN MA TRẬN PIXEL
    // =========================================================================
    let lastExecutedDir = 0; // Luôn lưu hướng thực tế bước trước để chống quay 180 độ
    const dirKeys = [
        { name: 'ArrowRight', code: 39, dx: 1, dy: 0 },
        { name: 'ArrowDown', code: 40, dx: 0, dy: 1 },
        { name: 'ArrowLeft', code: 37, dx: -1, dy: 0 },
        { name: 'ArrowUp', code: 38, dx: 0, dy: -1 }
    ];

    function sendKeyToTarget(cv, keyObj) {
        try {
            cv.focus();
            ['keydown', 'keyup'].forEach(evtType => {
                const kEvt = new KeyboardEvent(evtType, {
                    key: keyObj.name,
                    code: keyObj.name,
                    keyCode: keyObj.code,
                    which: keyObj.code,
                    bubbles: true,
                    cancelable: true,
                    composed: true
                });
                cv.dispatchEvent(kEvt);
                window.dispatchEvent(kEvt);
                document.dispatchEvent(kEvt);
            });
        } catch(e) {}
    }

    function autoRestartCanvas(cv) {
        const rect = cv.getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0) {
            const clickX = rect.left + rect.width * 0.38;
            const clickY = rect.top + rect.height * 0.63;

            ['mousedown', 'mouseup', 'click'].forEach(evtName => {
                try {
                    const mEvt = new MouseEvent(evtName, {
                        clientX: clickX,
                        clientY: clickY,
                        bubbles: true,
                        cancelable: true
                    });
                    cv.dispatchEvent(mEvt);
                } catch(err) {}
            });
        }
    }

    // KIỂM TRA HƯỚNG CÓ NẠP VÀO 180 ĐỘ SO VỚI BƯỚC VỪA ĐI HAY KHÔNG
    function isOpposite(d1, d2) {
        return (d1 === 0 && d2 === 2) || (d1 === 2 && d2 === 0) ||
               (d1 === 1 && d2 === 3) || (d1 === 3 && d2 === 1);
    }

    // ĐẾM SỐ Ô TRỐNG KHẢ DỤNG (SURVIVAL SPACE SEARCH)
    function countFreeSpace(grid, startX, startY, rows, cols) {
        let count = 0;
        const q = [[startX, startY]];
        const visited = Array.from({ length: rows }, () => Array(cols).fill(false));
        visited[startY][startX] = true;

        while (q.length > 0) {
            const [cx, cy] = q.shift();
            count++;
            for (let d = 0; d < 4; d++) {
                const nx = cx + dirKeys[d].dx;
                const ny = cy + dirKeys[d].dy;
                if (nx >= 0 && nx < cols && ny >= 0 && ny < rows && !visited[ny][nx] && grid[ny][nx] === 0) {
                    visited[ny][nx] = true;
                    q.push([nx, ny]);
                }
            }
        }
        return count;
    }

    function processSnakeVisionAndPathfinding() {
        if (!window.vltkAutoSnake) return;

        const cv = document.getElementById('arena');
        if (!cv || cv.offsetWidth === 0) return;

        // 1. Tự nhấp Chơi lại khi màn chơi dừng
        autoRestartCanvas(cv);

        const ctx = cv.getContext('2d');
        if (!ctx) return;

        const w = cv.width || 480;
        const h = cv.height || 480;

        // Bàn cờ tiêu chuẩn 15x15
        const cols = 15;
        const rows = 15;
        const cellW = w / cols;
        const cellH = h / rows;

        let head = null;
        let food = null;
        const grid = Array.from({ length: rows }, () => Array(cols).fill(0));

        try {
            const imgData = ctx.getImageData(0, 0, w, h);
            const pixels = imgData.data;

            // 2. Quét Ma trận Pixel phát hiện vị trí chính xác với dải màu mở rộng
            for (let r = 0; r < rows; r++) {
                for (let c = 0; c < cols; c++) {
                    const cx = Math.floor(c * cellW + cellW / 2);
                    const cy = Math.floor(r * cellH + cellH / 2);
                    const idx = (cy * w + cx) * 4;

                    const red = pixels[idx];
                    const green = pixels[idx + 1];
                    const blue = pixels[idx + 2];

                    // Phát hiện chấm mồi màu vàng/cam (Dải rộng linh hoạt)
                    if (red > 180 && green > 100 && blue < 120 && !(green > 160 && red < 150)) {
                        food = { x: c, y: r };
                    }
                    // Phát hiện đầu rắn (Màu xanh lá sáng)
                    else if (green > 160 && red < 160) {
                        if (!head) head = { x: c, y: r };
                        grid[r][c] = 1;
                    }
                    // Phát hiện thân rắn
                    else if (green > 80 && red < 150 && blue < 130) {
                        grid[r][c] = 1;
                    }
                }
            }

            if (!head) return;

            // 3. Thuật toán BFS Tìm đường ngắn nhất tới mồi
            let nextMoveDir = -1;

            if (food) {
                const queue = [[head.x, head.y, []]];
                const visited = Array.from({ length: rows }, () => Array(cols).fill(false));
                visited[head.y][head.x] = true;

                while (queue.length > 0) {
                    const [cx, cy, path] = queue.shift();

                    if (cx === food.x && cy === food.y && path.length > 0) {
                        nextMoveDir = path[0];
                        break;
                    }

                    for (let d = 0; d < 4; d++) {
                        const firstStep = path.length > 0 ? path[0] : d;
                        if (isOpposite(firstStep, lastExecutedDir)) continue;

                        const nx = cx + dirKeys[d].dx;
                        const ny = cy + dirKeys[d].dy;

                        if (nx >= 0 && nx < cols && ny >= 0 && ny < rows && !visited[ny][nx] && grid[ny][nx] === 0) {
                            visited[ny][nx] = true;
                            queue.push([nx, ny, [...path, d]]);
                        }
                    }
                }
            }

            // 4. Nếu BFS không có đường tới mồi, tìm đường an toàn có VÙNG SỐNG TỐT NHẤT
            if (nextMoveDir === -1) {
                let maxSpace = -1;
                for (let d = 0; d < 4; d++) {
                    if (isOpposite(d, lastExecutedDir)) continue;

                    const nx = head.x + dirKeys[d].dx;
                    const ny = head.y + dirKeys[d].dy;

                    if (nx >= 0 && nx < cols && ny >= 0 && ny < rows && grid[ny][nx] === 0) {
                        const freeSpace = countFreeSpace(grid, nx, ny, rows, cols);
                        if (freeSpace > maxSpace) {
                            maxSpace = freeSpace;
                            nextMoveDir = d;
                        }
                    }
                }
            }

            // 5. CẢNH BÁO NÉ TƯỜNG KHẨN CẤP (EMERGENCY WALL DODGE)
            if (nextMoveDir !== -1) {
                const testX = head.x + dirKeys[nextMoveDir].dx;
                const testY = head.y + dirKeys[nextMoveDir].dy;

                if (testX < 0 || testX >= cols || testY < 0 || testY >= rows || grid[testY][testX] === 1) {
                    for (let safeD = 0; safeD < 4; safeD++) {
                        if (isOpposite(safeD, lastExecutedDir)) continue;
                        const sx = head.x + dirKeys[safeD].dx;
                        const sy = head.y + dirKeys[safeD].dy;
                        if (sx >= 0 && sx < cols && sy >= 0 && sy < rows && grid[sy][sx] === 0) {
                            nextMoveDir = safeD;
                            break;
                        }
                    }
                }
            }

            // 6. Thực thi di chuyển
            if (nextMoveDir !== -1 && !isOpposite(nextMoveDir, lastExecutedDir)) {
                lastExecutedDir = nextMoveDir;
                sendKeyToTarget(cv, dirKeys[nextMoveDir]);
            }
        } catch(e) {}
    }

    // CẬP NHẬT CODE MỚI TỪ LINK RAW
    function performAutoUpdate(btnUpdate) {
        if (!btnUpdate) return;
        btnUpdate.innerText = '⏳ Đang tải...';
        btnUpdate.style.background = '#fab387';

        fetch(REMOTE_CODE_URL + '?t=' + new Date().getTime())
            .then(res => res.text())
            .then(code => {
                // Kiểm tra cú pháp hợp lệ trước khi lưu
                try {
                    new Function(code);
                } catch(syntaxErr) {
                    btnUpdate.innerText = '🔄 Cập nhật Tool';
                    btnUpdate.style.background = '#89b4fa';
                    alert('Lỗi: File code tải về từ GitHub có chứa lỗi cú pháp JavaScript!\nVui lòng kiểm tra lại file trên GitHub.');
                    return;
                }

                localStorage.setItem('VLTK_CUSTOM_SCRIPT', code);
                btnUpdate.innerText = '✅ Thành công!';
                btnUpdate.style.background = '#a6e3a1';
                alert('Cập nhật bản mới thành công! Trang web sẽ tự động tải lại.');
                location.reload();
            })
            .catch(() => {
                alert('Lỗi kết nối tải bản cập nhật từ GitHub!');
                if (btnUpdate) {
                    btnUpdate.innerText = '🔄 Cập nhật Tool';
                    btnUpdate.style.background = '#89b4fa';
                }
            });
    }

    // KIỂM TRA TRẠNG THÁI CANVAS #ARENA
    function checkMinigameStatus() {
        try {
            const arenaCanvas = document.getElementById('arena');
            isMinigameOpen = !!(arenaCanvas && arenaCanvas.offsetWidth > 0);

            if (isMinigameOpen) {
                processSnakeVisionAndPathfinding();
            }
        } catch(e) { 
            isMinigameOpen = false; 
        }
    }

    // AUTO THÁP & NÉ SKILL
    function executeAutoThapSequence() {
        if (!window.vltkAutoThap1 && !window.vltkAutoThap2) return;
        try {
            if (typeof Mi !== 'undefined') {
                const isDead = (Mi.P && (Mi.P.hp <= 0 || Mi.P.isDead));
                const inThap = (Mi.mapName && Mi.mapName.includes('Tháp')) || (Mi.inThap === true);
                if (isDead || !inThap) {
                    clickByText('Hồi sinh');
                    clickByText('Về thành');
                    setTimeout(() => {
                        clickByText('Tháp');
                        clickByText('Võ Quán');
                        setTimeout(() => {
                            if (window.vltkAutoThap1) {
                                if (Mi.socket && typeof Mi.socket.emit === 'function') Mi.socket.emit('goThap', { id: 1 });
                                clickByText('Tháp 1');
                            } else if (window.vltkAutoThap2) {
                                if (Mi.socket && typeof Mi.socket.emit === 'function') Mi.socket.emit('goThap', { id: 2 });
                                clickByText('Tháp 2');
                            }
                            clickByText('Thử thách');
                            clickByText('Vào tháp');
                        }, 300);
                    }, 500);
                }
            }
        } catch(e) {}
    }

    function executeDodgeAndAttack() {
        try {
            if (typeof Mi !== 'undefined' && Mi.P) {
                if (typeof Mi.useSkill === 'function') Mi.useSkill();
                if (window.vltkDodgeSkill) {
                    dodgeAngle += 0.2;
                    const radius = 120;
                    let centerX = Mi.P.x || 400;
                    let centerY = Mi.P.y || 300;
                    if (Mi.monsters && Mi.monsters.length > 0 && Mi.monsters[0]) {
                        centerX = Mi.monsters[0].x || centerX;
                        centerY = Mi.monsters[0].y || centerY;
                    }
                    const targetX = centerX + Math.cos(dodgeAngle) * radius;
                    const targetY = centerY + Math.sin(dodgeAngle) * radius;
                    if (typeof Mi.moveTo === 'function') Mi.moveTo(targetX, targetY);
                    else { Mi.P.x = targetX; Mi.P.y = targetY; }
                }
            }
        } catch(e) {}
    }

    function executeAutoRebirthSequence() {
        if (!window.vltkAutoCS || isCsProcessing) return;
        try {
            if (typeof Mi !== 'undefined') {
                const hasCsButton = Array.from(document.querySelectorAll('button, div, span, a')).some(
                    el => el.innerText && el.innerText.trim().includes('Chuyển sinh')
                );
                if (hasCsButton || (Mi.P && Mi.P.lv >= 140)) {
                    isCsProcessing = true;
                    if (Mi.socket && typeof Mi.socket.emit === 'function') Mi.socket.emit('cs');
                    clickByText('Chuyển sinh');
                    setTimeout(() => {
                        clickByText('Chắc chắn');
                        clickByText('Về cấp 1');
                        setTimeout(() => { isCsProcessing = false; }, 500);
                    }, 400);
                }
            }
        } catch(e) { isCsProcessing = false; }
    }

    // AUTO ĐỔI EVENT
    function getEventItemList() {
        const items = [];
        const allNodes = document.querySelectorAll('div, span, td, p, button, a');
        allNodes.forEach(node => {
            if (node.innerText && node.innerText.trim() === 'Đổi') {
                let parent = node.parentElement;
                for (let i = 0; i < 4 && parent; i++) {
                    const txt = parent.innerText ? parent.innerText.replace(/\n/g, ' ').trim() : '';
                    if (txt && txt.includes('Bánh Trung Thu') && txt.includes('Đổi')) {
                        let cleanName = txt.split('Đổi')[0].split(/\d+\s*Bánh/)[0].trim();
                        if (cleanName && cleanName.length < 30 && !items.some(it => it.text === cleanName)) {
                            items.push({ text: cleanName, top: node.getBoundingClientRect().top });
                        }
                        break;
                    }
                    parent = parent.parentElement;
                }
            }
        });
        return items;
    }

    function exchangeSelectedItem(times = 1) {
        const sel = document.getElementById('v-sel-event');
        if (!sel || !sel.value) return alert('Vui lòng mở tab Sự kiện rồi bấm Quét Món!');

        const targetText = sel.value.trim();
        let count = 0;

        const timer = setInterval(() => {
            let targetY = -1;
            const allNodes = document.querySelectorAll('div, span, td, p, button, a');

            for (let node of allNodes) {
                if (node.innerText && node.innerText.trim() === targetText) {
                    targetY = node.getBoundingClientRect().top;
                    break;
                }
            }

            let clicked = false;
            if (targetY > 0) {
                for (let node of allNodes) {
                    if (node.innerText && node.innerText.trim() === 'Đổi') {
                        const rect = node.getBoundingClientRect();
                        if (Math.abs(rect.top - targetY) < 30) {
                            triggerFullClick(node);
                            clicked = true;
                            break;
                        }
                    }
                }
            }

            count++;
            if (count >= times || !clicked) clearInterval(timer);
        }, 100);
    }

    // ENGINE SPEED CONTROL (TỰ TẮT HACK SPEED KHI MỞ RẮN)
    const originalRAF = window.requestAnimationFrame;
    let lastTime = performance.now();
    let virtualTime = lastTime;

    window.requestAnimationFrame = function(callback) {
        return originalRAF(function(now) {
            const dt = now - lastTime;
            lastTime = now;
            const currentSpeed = (window.vltkSpeedEnabled && !isMinigameOpen) ? (window.vltkSelectedSpeed || 1) : 1;
            virtualTime += dt * currentSpeed;

            try {
                if (typeof Mi !== 'undefined') {
                    if (!isMinigameOpen) {
                        Mi.spawnT = 0;
                        if (Mi.monsters && Mi.monsters.length === 0) {
                            if (typeof Mi.spawnMonster === 'function') Mi.spawnMonster();
                            if (Mi.socket && typeof Mi.socket.emit === 'function') Mi.socket.emit('spawn');
                        }
                    }
                    if (window.vltkAutoRemotePick) Mi.pickDist = 99999;
                    executeDodgeAndAttack();
                }
            } catch(e) {}
            callback(virtualTime);
        });
    };

    setInterval(() => {
        checkMinigameStatus();
        if (window.vltkAutoCS) executeAutoRebirthSequence();
        executeAutoThapSequence();
    }, 120);

