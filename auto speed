// ==UserScript==
// @name         VLTK Idle - Auto Snake Game Fix v35.2
// @namespace    http://tampermonkey.net/
// @version      35.2
// @description  Tối ưu can thiệp Canvas & Tự động chạy Rắn Săn Mồi
// @match        *://hoainiem2003.net/*
// @allFrames    true
// @grant        none
// @run-at       document-end
// ==/UserScript==

(function() {
    'use strict';

    const REMOTE_CODE_URL = 'https://raw.githubusercontent.com/hunterkay01/vltk-auto-tool/main/auto%20speed';

    window.vltkSpeedEnabled = true;
    window.vltkSelectedSpeed = 1;
    window.vltkSpeed = 1;
    
    window.vltkAutoCS = true;
    window.vltkAutoRemotePick = true;

    window.vltkAutoThap1 = false;
    window.vltkAutoThap2 = false;
    window.vltkDodgeSkill = false;
    window.vltkAutoSnake = true;

    let isCsProcessing = false;
    let dodgeAngle = 0;
    let isMinigameOpen = false;
    let autoEventInterval = null;

    function triggerFullClick(el) {
        if (!el) return false;
        const events = ['pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click'];
        events.forEach(evt => {
            const e = new MouseEvent(evt, {
                view: window,
                bubbles: true,
                cancelable: true
            });
            el.dispatchEvent(e);
        });
        if (typeof el.click === 'function') el.click();
        return true;
    }

    function clickByText(text, exact = false) {
        const allNodes = document.querySelectorAll('button, div, span, a, p, td');
        let found = false;
        for (let el of allNodes) {
            if (el.innerText) {
                const inner = el.innerText.trim();
                if (exact ? inner === text : inner.includes(text)) {
                    triggerFullClick(el);
                    found = true;
                }
            }
        }
        return found;
    }

    // 🐍 HÀM ĐIỀU KHIỂN VÀ CAN THIỆP RẮN SĂN MỒI
    let snakeDirIndex = 0;
    const keyCodes = [39, 40, 37, 38]; // Phải, Xuống, Trái, Lên
    const keyNames = ['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp'];

    function processAutoSnakeGame() {
        if (!window.vltkAutoSnake) return;

        try {
            // 1. Tự động click nút "Chơi lại" hoặc nút "Chơi" nếu đang ở màn hình kết thúc
            clickByText('Chơi lại');
            clickByText('Chơi');

            // 2. Can thiệp trực tiếp vào Engine game để di chuyển Rắn
            if (typeof Mi !== 'undefined' && Mi.snake) {
                if (typeof Mi.snake.changeDir === 'function') {
                    Mi.snake.changeDir(snakeDirIndex % 4);
                } else if (typeof Mi.snake.setDir === 'function') {
                    Mi.snake.setDir(snakeDirIndex % 4);
                } else {
                    Mi.snake.dir = snakeDirIndex % 4;
                }
                snakeDirIndex++;
                return;
            }

            // 3. Gửi phím giả lập tần số cao vào Canvas và Window
            const dirIdx = snakeDirIndex % 4;
            const kCode = keyCodes[dirIdx];
            const kName = keyNames[dirIdx];

            const eventInit = {
                key: kName,
                code: kName,
                keyCode: kCode,
                which: kCode,
                bubbles: true,
                cancelable: true
            };

            const kEventDown = new KeyboardEvent('keydown', eventInit);
            const kEventUp = new KeyboardEvent('keyup', eventInit);

            window.dispatchEvent(kEventDown);
            document.dispatchEvent(kEventDown);

            const canvases = document.querySelectorAll('canvas');
            canvases.forEach(cv => {
                cv.dispatchEvent(kEventDown);
                cv.dispatchEvent(kEventUp);
            });

            snakeDirIndex++;
        } catch(e) {}
    }

    // CẬP NHẬT CODE MỚI TỪ LINK RAW
    function performAutoUpdate(btnUpdate) {
        btnUpdate.innerText = '⏳ Đang tải...';
        btnUpdate.style.background = '#fab387';

        fetch(REMOTE_CODE_URL + '?t=' + new Date().getTime())
            .then(res => res.text())
            .then(code => {
                localStorage.setItem('VLTK_CUSTOM_SCRIPT', code);
                btnUpdate.innerText = '✅ Thành công!';
                btnUpdate.style.background = '#a6e3a1';
                alert('Cập nhật bản mới thành công! Trang web sẽ tự động tải lại.');
                location.reload();
            })
            .catch(() => {
                alert('Lỗi kết nối tải bản cập nhật!');
                btnUpdate.innerText = '🔄 Cập nhật Tool';
                btnUpdate.style.background = '#89b4fa';
            });
    }

    // KIỂM TRA MẮT THẤY RẮN SĂN MỒI
    function checkMinigameStatus() {
        try {
            const gameKeywords = ['Rắn săn mồi', 'Giải trí', 'Trò chơi', 'Mini Game', 'Kết thúc!'];
            const allElements = document.querySelectorAll('div, span, iframe, section, canvas');
            let detected = false;

            for (let el of allElements) {
                if (el.offsetWidth > 0 && el.offsetHeight > 0) {
                    const txt = el.innerText ? el.innerText.trim() : '';
                    if (gameKeywords.some(kw => txt.includes(kw)) && (el.style.display !== 'none' && el.style.visibility !== 'hidden')) {
                        detected = true;
                        break;
                    }
                }
            }

            if (typeof Mi !== 'undefined' && (Mi.inMinigame || Mi.isMinigameOpen || Mi.snakeGame || Mi.snake)) {
                detected = true;
            }

            isMinigameOpen = detected;

            if (isMinigameOpen) {
                processAutoSnakeGame();
            }
        } catch(e) { 
            isMinigameOpen = false; 
        }
    }

    // AUTO THÁP & NÉ SKILL
    function executeAutoThapSequence() {
        if (!window.vltkAutoThap1 && !window.vltkAutoThap2) return;
        try {
            if (typeof Mi !== 'undefined') {
                const isDead = (Mi.P && (Mi.P.hp <= 0 || Mi.P.isDead));
                const inThap = (Mi.mapName && Mi.mapName.includes('Tháp')) || (Mi.inThap === true);
                if (isDead || !inThap) {
                    clickByText('Hồi sinh');
                    clickByText('Về thành');
                    setTimeout(() => {
                        clickByText('Tháp');
                        clickByText('Võ Quán');
                        setTimeout(() => {
                            if (window.vltkAutoThap1) {
                                if (Mi.socket && typeof Mi.socket.emit === 'function') Mi.socket.emit('goThap', { id: 1 });
                                clickByText('Tháp 1');
                            } else if (window.vltkAutoThap2) {
                                if (Mi.socket && typeof Mi.socket.emit === 'function') Mi.socket.emit('goThap', { id: 2 });
                                clickByText('Tháp 2');
                            }
                            clickByText('Thử thách');
                            clickByText('Vào tháp');
                        }, 300);
                    }, 500);
                }
            }
        } catch(e) {}
    }

    function executeDodgeAndAttack() {
        try {
            if (typeof Mi !== 'undefined' && Mi.P) {
                if (typeof Mi.useSkill === 'function') Mi.useSkill();
                if (window.vltkDodgeSkill) {
                    dodgeAngle += 0.2;
                    const radius = 120;
                    let centerX = Mi.P.x || 400;
                    let centerY = Mi.P.y || 300;
                    if (Mi.monsters && Mi.monsters.length > 0 && Mi.monsters[0]) {
                        centerX = Mi.monsters[0].x || centerX;
                        centerY = Mi.monsters[0].y || centerY;
                    }
                    const targetX = centerX + Math.cos(dodgeAngle) * radius;
                    const targetY = centerY + Math.sin(dodgeAngle) * radius;
                    if (typeof Mi.moveTo === 'function') Mi.moveTo(targetX, targetY);
                    else { Mi.P.x = targetX; Mi.P.y = targetY; }
                }
            }
        } catch(e) {}
    }

    function executeAutoRebirthSequence() {
        if (!window.vltkAutoCS || isCsProcessing) return;
        try {
            if (typeof Mi !== 'undefined') {
                const hasCsButton = Array.from(document.querySelectorAll('button, div, span, a')).some(
                    el => el.innerText && el.innerText.trim().includes('Chuyển sinh')
                );
                if (hasCsButton || (Mi.P && Mi.P.lv >= 140)) {
                    isCsProcessing = true;
                    if (Mi.socket && typeof Mi.socket.emit === 'function') Mi.socket.emit('cs');
                    clickByText('Chuyển sinh');
                    setTimeout(() => {
                        clickByText('Chắc chắn');
                        clickByText('Về cấp 1');
                        setTimeout(() => { isCsProcessing = false; }, 500);
                    }, 400);
                }
            }
        } catch(e) { isCsProcessing = false; }
    }

    // AUTO ĐỔI EVENT
    function getEventItemList() {
        const items = [];
        const allNodes = document.querySelectorAll('div, span, td, p, button, a');
        allNodes.forEach(node => {
            if (node.innerText && node.innerText.trim() === 'Đổi') {
                let parent = node.parentElement;
                for (let i = 0; i < 4 && parent; i++) {
                    const txt = parent.innerText ? parent.innerText.replace(/\n/g, ' ').trim() : '';
                    if (txt && txt.includes('Bánh Trung Thu') && txt.includes('Đổi')) {
                        let cleanName = txt.split('Đổi')[0].split(/\d+\s*Bánh/)[0].trim();
                        if (cleanName && cleanName.length < 30 && !items.some(it => it.text === cleanName)) {
                            items.push({ text: cleanName, top: node.getBoundingClientRect().top });
                        }
                        break;
                    }
                    parent = parent.parentElement;
                }
            }
        });
        return items;
    }

    function exchangeSelectedItem(times = 1) {
        const sel = document.getElementById('v-sel-event');
        if (!sel || !sel.value) return alert('Vui lòng mở tab Sự kiện rồi bấm Quét Món!');

        const targetText = sel.value.trim();
        let count = 0;

        const timer = setInterval(() => {
            let targetY = -1;
            const allNodes = document.querySelectorAll('div, span, td, p, button, a');

            for (let node of allNodes) {
                if (node.innerText && node.innerText.trim() === targetText) {
                    targetY = node.getBoundingClientRect().top;
                    break;
                }
            }

            let clicked = false;
            if (targetY > 0) {
                for (let node of allNodes) {
                    if (node.innerText && node.innerText.trim() === 'Đổi') {
                        const rect = node.getBoundingClientRect();
                        if (Math.abs(rect.top - targetY) < 30) {
                            triggerFullClick(node);
                            clicked = true;
                            break;
                        }
                    }
                }
            }

            count++;
            if (count >= times || !clicked) clearInterval(timer);
        }, 100);
    }

    // ENGINE SPEED CONTROL
    const originalRAF = window.requestAnimationFrame;
    let lastTime = performance.now();
    let virtualTime = lastTime;

    window.requestAnimationFrame = function(callback) {
        return originalRAF(function(now) {
            const dt = now - lastTime;
            lastTime = now;
            const currentSpeed = (window.vltkSpeedEnabled && !isMinigameOpen) ? (window.vltkSelectedSpeed || 1) : 1;
            virtualTime += dt * currentSpeed;

            try {
                if (typeof Mi !== 'undefined') {
                    if (!isMinigameOpen) {
                        Mi.spawnT = 0;
                        if (Mi.monsters && Mi.monsters.length === 0) {
                            if (typeof Mi.spawnMonster === 'function') Mi.spawnMonster();
                            if (Mi.socket && typeof Mi.socket.emit === 'function') Mi.socket.emit('spawn');
                        }
                    }
                    if (window.vltkAutoRemotePick) Mi.pickDist = 99999;
                    executeDodgeAndAttack();
                }
            } catch(e) {}
            callback(virtualTime);
        });
    };

    // VÒNG LẶP KIỂM TRA TỐC ĐỘ CAO CHO RẮN SĂN MỒI
    setInterval(() => {
        checkMinigameStatus();
        if (window.vltkAutoCS) executeAutoRebirthSequence();
        executeAutoThapSequence();
    }, 150);

