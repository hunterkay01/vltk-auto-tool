        targetBody.appendChild(container);

        const dockBar = container.querySelector('#v-dock-bar');
        const dockDrag = container.querySelector('#v-dock-drag');
        const popup = container.querySelector('#v-popup-panel');
        const popupDrag = container.querySelector('#v-popup-drag');
        const popupTitle = container.querySelector('#v-popup-title');
        const popupClose = container.querySelector('#v-popup-close');

        let dragD = false, oxD = 0, oyD = 0;
        dockDrag.addEventListener('mousedown', (e) => {
            dragD = true;
            oxD = e.clientX - dockBar.offsetLeft;
            oyD = e.clientY - dockBar.offsetTop;
        });
        document.addEventListener('mousemove', (e) => {
            if (dragD) {
                dockBar.style.left = (e.clientX - oxD) + 'px';
                dockBar.style.top = (e.clientY - oyD) + 'px';
            }
        });
        document.addEventListener('mouseup', () => dragD = false);

        let dragP = false, oxP = 0, oyP = 0;
        popupDrag.addEventListener('mousedown', (e) => {
            if (e.target === popupClose) return;
            dragP = true;
            oxP = e.clientX - popup.offsetLeft;
            oyP = e.clientY - popup.offsetTop;
        });
        document.addEventListener('mousemove', (e) => {
            if (dragP) {
                popup.style.left = (e.clientX - oxP) + 'px';
                popup.style.top = (e.clientY - oyP) + 'px';
            }
        });
        document.addEventListener('mouseup', () => dragP = false);

        const btnSpeed = container.querySelector('#v-icon-speed');
        const btnEvent = container.querySelector('#v-icon-event');
        const btnMini = container.querySelector('#v-icon-mini');
        const btnAuto = container.querySelector('#v-icon-auto');

        const boxSpeed = container.querySelector('#v-box-speed');
        const boxEvent = container.querySelector('#v-box-event');
        const boxMini = container.querySelector('#v-box-mini');
        const boxAuto = container.querySelector('#v-box-auto');

        function openTab(box, title, activeBtn) {
            [boxSpeed, boxEvent, boxMini, boxAuto].forEach(b => b.style.display = 'none');
            [btnSpeed, btnEvent, btnMini, btnAuto].forEach(b => b.style.borderColor = '#45475a');

            if (popup.style.display === 'block' && popupTitle.innerText.includes(title)) {
                popup.style.display = 'none';
            } else {
                popup.style.display = 'block';
                box.style.display = 'block';
                popupTitle.innerText = '🖐️ ' + title;
                activeBtn.style.borderColor = '#a6e3a1';
            }
        }

        btnSpeed.onclick = () => openTab(boxSpeed, '⚡ HACK SPEED', btnSpeed);
        btnEvent.onclick = () => openTab(boxEvent, '🎁 AUTO ĐỔI EVENT', btnEvent);
        btnMini.onclick = () => openTab(boxMini, '🎮 AUTO MINI GAME', btnMini);
        btnAuto.onclick = () => openTab(boxAuto, '🔄 AUTO TỰ ĐỘNG', btnAuto);

        popupClose.onclick = () => {
            popup.style.display = 'none';
            [btnSpeed, btnEvent, btnMini, btnAuto].forEach(b => b.style.borderColor = '#45475a');
        };

        const btnSnakeSw = container.querySelector('#v-btn-snake-sw');
        btnSnakeSw.onclick = () => {
            window.vltkAutoSnake = !window.vltkAutoSnake;
            btnSnakeSw.innerText = window.vltkAutoSnake ? 'ON' : 'OFF';
            btnSnakeSw.style.background = window.vltkAutoSnake ? '#a6e3a1' : '#f38ba8';
        };

        const selEvent = container.querySelector('#v-sel-event');
        const btnScanEv = container.querySelector('#v-btn-scan-ev');
        const btnDoEv10 = container.querySelector('#v-btn-do-ev10');
        const btnDoEvAuto = container.querySelector('#v-btn-do-evauto');

        btnScanEv.onclick = () => {
            const list = getEventItemList();
            selEvent.innerHTML = '';
            if (list.length === 0) {
                selEvent.innerHTML = '<option value="">(Không tìm thấy, mở tab Event thử lại)</option>';
                alert('Vui lòng mở tab Sự kiện trong game trước rồi nhấn Quét Món lại!');
            } else {
                list.forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item.text;
                    opt.innerText = item.text;
                    selEvent.appendChild(opt);
                });
            }
        };

        btnDoEv10.onclick = () => exchangeSelectedItem(10);

        let isAutoEvRunning = false;
        btnDoEvAuto.onclick = () => {
            isAutoEvRunning = !isAutoEvRunning;
            if (isAutoEvRunning) {
                btnDoEvAuto.innerText = '⏹️ Dừng';
                btnDoEvAuto.style.background = '#f38ba8';
                autoEventInterval = setInterval(() => exchangeSelectedItem(1), 100);
            } else {
                btnDoEvAuto.innerText = '🔁 Auto Đổi';
                btnDoEvAuto.style.background = '#a6e3a1';
                clearInterval(autoEventInterval);
            }
        };

        const btnUpdateCode = container.querySelector('#v-btn-update-code');
        btnUpdateCode.onclick = () => performAutoUpdate(btnUpdateCode);

        const btnSw = container.querySelector('#v-btn-sw');
        btnSw.onclick = () => {
            window.vltkSpeedEnabled = !window.vltkSpeedEnabled;
            btnSw.innerText = window.vltkSpeedEnabled ? 'ON' : 'OFF';
            btnSw.style.background = window.vltkSpeedEnabled ? '#a6e3a1' : '#f38ba8';
        };

        container.querySelectorAll('.v-btn.spd').forEach(btn => {
            btn.onclick = () => {
                container.querySelectorAll('.v-btn.spd').forEach(b => {
                    b.style.background = '#313244';
                    b.style.color = '#cdd6f4';
                });
                btn.style.background = '#a6e3a1';
                btn.style.color = '#11111b';
                window.vltkSelectedSpeed = parseFloat(btn.dataset.val);
                window.vltkSpeedEnabled = true;
                btnSw.innerText = 'ON';
                btnSw.style.background = '#a6e3a1';
            };
        });

        const btnPick = container.querySelector('#v-btn-pick');
        const btnCS = container.querySelector('#v-btn-cs');

        btnPick.onclick = () => {
            window.vltkAutoRemotePick = !window.vltkAutoRemotePick;
            btnPick.innerText = window.vltkAutoRemotePick ? 'ON' : 'OFF';
            btnPick.style.background = window.vltkAutoRemotePick ? '#a6e3a1' : '#f38ba8';
        };

        btnCS.onclick = () => {
            window.vltkAutoCS = !window.vltkAutoCS;
            btnCS.innerText = window.vltkAutoCS ? 'ON' : 'OFF';
            btnCS.style.background = window.vltkAutoCS ? '#a6e3a1' : '#f38ba8';
        };

        const chkThap1 = container.querySelector('#v-chk-thap1');
        const chkThap2 = container.querySelector('#v-chk-thap2');
        const chkDodge = container.querySelector('#v-chk-dodge');

        chkThap1.onchange = (e) => {
            window.vltkAutoThap1 = e.target.checked;
            if (e.target.checked) {
                window.vltkAutoThap2 = false;
                chkThap2.checked = false;
            }
        };

        chkThap2.onchange = (e) => {
            window.vltkAutoThap2 = e.target.checked;
            if (e.target.checked) {
                window.vltkAutoThap1 = false;
                chkThap1.checked = false;
            }
        };

        chkDodge.onchange = (e) => {
            window.vltkDodgeSkill = e.target.checked;
        };
    }

    injectUI();
    setInterval(injectUI, 2000);
})();
